# Copy to .env and replace the placeholder values. Process environment wins over this file.
# Server and Telegram
HOST=127.0.0.1
PORT=8000
PUBLIC_URL=http://127.0.0.1:8000/webhook
TELEGRAM_BOT_TOKEN=replace-with-your-bot-token
TELEGRAM_CHAT_ID=replace-with-your-chat-id
TELEGRAM_POLL_SECONDS=10
WEBHOOK_LOG_FILE=webhook.log
TIMEZONE_OFFSET_HOURS=8
PHILIPPINE_TIMEZONE=Asia/Manila
EA_HEARTBEAT_STALE_SECONDS=90
PRICE_DATA_STALE_SECONDS=120
EVENT_DELAY_SECONDS=60
SYMBOL_ALIASES_JSON={"GOLD":["Goldmicro","Goldm#","XAUUSD"]}
# Files and MT5 source sync
ACCOUNT_DB_FILE=account_state.db
TRADE_STATE_FILE=trade_state.json
MT5_EXPERTS_DIR=C:/path/to/MetaTrader/MQL5/Experts
# Trade configuration
TRADE_LOT_SIZE=0.1
TRAIL_PIPS=20
GOLD_PIP_SIZE=0.1
# Account actions: keep disabled until demo-tested.
ACCOUNT_ACTIONS_ENABLED=false
ACCOUNT_ACTION_SECRET=replace-with-a-long-random-secret
AUTHORIZED_TELEGRAM_CHAT=replace-with-your-chat-id
AUTHORIZED_TELEGRAM_USER=
CONFIRMATION_EXPIRY_SECONDS=120
ACCOUNT_ACTION_LEASE_SECONDS=60
PROFIT_ALERT_PIPS=50
BREAKEVEN_ELIGIBILITY_PIPS=30
BREAKEVEN_PROTECTED_PIPS=10
# Scheduled reports
DAILY_REPORT_ENABLED=true
DAILY_REPORT_HOUR=6
SESSION_REPORTS_ENABLED=true
REPORT_RECOVERY_DAYS=7
REPORT_SESSIONS=Asian|Asia/Tokyo|09:00|18:00,London|Europe/London|08:00|17:00,New York|America/New_York|08:00|17:00
SESSION_ASIAN_ENABLED=true
SESSION_LONDON_ENABLED=true
SESSION_NEW_YORK_ENABLED=true
# Market structure and key-level alerts
MARKET_STRICTNESS=balanced
STRUCTURE_SWING_BARS_M30=2
STRUCTURE_SWING_BARS_H1=2
STRUCTURE_SWING_BARS_H4=2
STRUCTURE_SWING_BARS_D1=2
STRUCTURE_MIN_PROMINENCE_ATR=0.35
STRUCTURE_BREAK_ATR_BUFFER=0.12
STRUCTURE_MIN_BODY_RATIO=0.5
STRUCTURE_MIN_CLOSE_LOCATION=0.65
LEVEL_REJECTION_WICK_RATIO=1.2
LEVEL_REJECTION_MIN_BODY_RATIO=0.25
LEVEL_SWEEP_PENETRATION_ATR=0.15
LEVEL_SWEEP_MIN_BODY_RATIO=0.35
LEVEL_REARM_DISTANCE_ATR=0.5
LEVEL_COOLDOWN_MULTIPLIER=5
LEVEL_STALE_UPDATES=20
LEVEL_COINCIDENCE_ATR=0.25
LEVEL_MIN_STRENGTH=0.75
LEVEL_RETENTION=200
LEVEL_ENABLED_TYPES=
LEVEL_ENABLED_EVENTS=
MARKET_DEBUG_LOGGING=false
# Closed-candle pattern filtering and scoring
PATTERN_ENABLED_TYPES=ENGULFING_CANDLE,HAMMER_CANDLE,HANGING_MAN_CANDLE,SHOOTING_STAR_CANDLE,INVERTED_HAMMER_CANDLE,MORNING_STAR,EVENING_STAR,INSIDE_BAR_BREAKOUT
PATTERN_ENABLED_TIMEFRAMES=M15,M30,H1,H4
PATTERN_DEBUG_LOGGING=false
PATTERN_INVALIDATION_ALERTS=false
PATTERN_INVALIDATION_ATR_RATIO=0.1
PATTERN_MIN_BODY_RATIO=0.1
PATTERN_MIN_WICK_BODY_RATIO=2.0
PATTERN_MIN_WICK_RANGE_RATIO=0.35
PATTERN_STAR_MAX_MIDDLE_BODY_RATIO=0.35
PATTERN_INSIDE_BREAKOUT_RATIO=0.15
PATTERN_MIN_ATR_RATIO=0.35
PATTERN_EXTREME_ATR_RATIO=2.5
PATTERN_LEVEL_ATR_TOLERANCE=0.5
PATTERN_SWEEP_MIN_ATR_RATIO=0.15
PATTERN_OPPOSING_LEVEL_ATR_TOLERANCE=0.75
PATTERN_DAILY_ATR_WARNING_RATIO=0.8
PATTERN_VOLUME_EXPANSION_RATIO=1.25
PATTERN_VOLUME_EXPANSION_SCORE=8
PATTERN_LOW_VOLUME_RATIO=0.7
PATTERN_LOW_VOLUME_SCORE=6
PATTERN_SESSION_SCORE=5
PATTERN_DAILY_ATR_WARNING_SCORE=8
PATTERN_VWAP_SCORE=8
PATTERN_VWAP_OPPOSING_SCORE=5
PATTERN_SWEEP_SCORE=12
PATTERN_OPPOSING_LEVEL_SCORE=12
PATTERN_MISSING_HTF_SCORE=15
PATTERN_MIN_ALERT_SCORE=60
PATTERN_COUNTERTREND_STRICTNESS=1.0
PATTERN_REQUIRE_HTF_ALIGNMENT=false
PATTERN_COUNTERTREND_IMMEDIATE=false
PATTERN_MAX_AGE_CANDLES=8
PATTERN_RETENTION_CANDLES=32
PATTERN_ALERT_GROUPING_ENABLED=true
PATTERN_CONFIRMATION_MODE=follow_through
PATTERN_ENGULFING_CANDLE_CONFIRMATION_MODE=immediate
PATTERN_HAMMER_CANDLE_CONFIRMATION_MODE=follow_through
PATTERN_HANGING_MAN_CANDLE_CONFIRMATION_MODE=follow_through
PATTERN_SHOOTING_STAR_CANDLE_CONFIRMATION_MODE=follow_through
PATTERN_INVERTED_HAMMER_CANDLE_CONFIRMATION_MODE=follow_through
PATTERN_MORNING_STAR_CONFIRMATION_MODE=follow_through
PATTERN_EVENING_STAR_CONFIRMATION_MODE=follow_through
PATTERN_INSIDE_BAR_BREAKOUT_CONFIRMATION_MODE=follow_through
PATTERN_SESSION_WINDOWS={}
PATTERN_CANDLE_TIMEZONE=Asia/Manila
PATTERN_SESSION_TIMEZONE=Asia/Manila
PATTERN_SESSION_WEIGHT_TOKYO=1.0
PATTERN_SESSION_WEIGHT_LONDON=1.0
PATTERN_SESSION_WEIGHT_NEW_YORK=1.0